{
  "name": "hoa-brain",
  "version": "0.1.0",
  "private": true,
  "description": "HOA Brain: MCP server for HOA documents (S3 Vectors) and budget data (Athena), using Bedrock embeddings",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "ingest": "tsx src/ingest.ts",
    "load:finance": "tsx src/loadFinance.ts",
    "eval": "tsx src/eval.ts",
    "selftest": "tsx scripts/selftest.ts",
    "mcp": "node build/server.js"
  },
  "dependencies": {
    "@aws-sdk/client-athena": "^3.1160.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1159.0",
    "@aws-sdk/client-s3": "^3.1159.0",
    "@aws-sdk/client-s3vectors": "^3.1159.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@napi-rs/canvas": "^1.1.0",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "mammoth": "^1.13.0",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
